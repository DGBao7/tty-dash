{
  "schema_version": 5,
  "application": {
    "always_on_top": false,
    "click_through": true,
    "opacity": 1.0,
    "monitoring_interval_ms": 1500
  },
  "effects": {
    "blur": false,
    "backdrop": "none",
    "background_color": "#00000000"
  },
  "terbon": {
    "enabled": true,
    "visible_on_startup": true,
    "monitor": "primary",
    "position": "right",
    "width": 700,
    "height": 350,
    "initial_working_directory": "D:/",
    "remember_geometry": true,
    "has_saved_geometry": false
  },
  "displays": [
    {
      "name": "primary",
      "position_mode": "top_left",
      "x": 0,
      "y": 0,
      "width": 0,
      "height": 0,
      "margins": {
        "left": 0,
        "top": 0,
        "right": 0,
        "bottom": 0
      },
      "widgets": [
        {
          "id": "clock",
          "type": "clock",
          "enabled": true,
          "position": { "mode": "adaptive_right", "x": 0, "y": 0 },
          "size": { "width": 340, "height": 112 },
          "options": {
            "time_format": "HH:mm:ss",
            "date_format": "dddd, dd MMMM yyyy",
            "display_font_size": 34
          }
        },
        {
          "id": "cpu",
          "type": "cpu",
          "enabled": true,
          "position": { "mode": "adaptive_right", "x": 0, "y": 0 },
          "size": { "width": 290, "height": 112 },
          "options": { "show_graph": true }
        },
        {
          "id": "ram",
          "type": "ram",
          "enabled": true,
          "position": { "mode": "adaptive_right", "x": 0, "y": 0 },
          "size": { "width": 290, "height": 112 },
          "options": { "show_graph": true }
        },
        {
          "id": "network",
          "type": "network",
          "enabled": true,
          "position": { "mode": "adaptive_right", "x": 0, "y": 0 },
          "size": { "width": 290, "height": 112 },
          "options": { "speed_unit": "auto" }
        },
        {
          "id": "matrix",
          "type": "matrix",
          "enabled": true,
          "position": { "mode": "adaptive_right", "x": 0, "y": 0 },
          "size": { "width": 420, "height": 500 },
          "options": { "animation_speed": 1.0, "density": 1.0, "interval_ms": 75 }
        },
        {
          "id": "pipes",
          "type": "pipes",
          "enabled": true,
          "position": { "mode": "adaptive_right", "x": 0, "y": 0 },
          "size": { "width": 400, "height": 220 },
          "options": { "animation_speed": 1.0, "interval_ms": 105 }
        }
      ]
    }
  ]
}
